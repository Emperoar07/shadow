{
  "name": "shadowperp",
  "version": "0.1.0",
  "description": "ShadowPerp - Private Perpetual Futures on Arcium",
  "scripts": {
    "build": "anchor build",
    "build:anchor:safe": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-anchor.ps1",
    "deploy:anchor:safe": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-anchor.ps1 -DeployDevnet",
    "deploy:devnet:fresh": "npx ts-node scripts/deploy-devnet.ts --fresh-namespace",
    "compdefs:init": "npx ts-node scripts/init-comp-defs.ts",
    "app:dev:sync-idl": "npx ts-node scripts/run-frontend.ts",
    "app:sync-idl": "npx ts-node scripts/run-frontend.ts --sync-only",
    "test": "anchor test",
    "dev": "cd app && npm run dev",
    "oracle:once": "npx ts-node scripts/price-oracle.ts --once",
    "oracle:daemon": "npx ts-node scripts/price-oracle.ts",
    "oracle:daemon:start": "npx ts-node scripts/oracle-daemon.ts start",
    "oracle:daemon:stop": "npx ts-node scripts/oracle-daemon.ts stop",
    "oracle:daemon:status": "npx ts-node scripts/oracle-daemon.ts status",
    "session:relayer:create": "npx ts-node scripts/session-relayer.ts create",
    "session:relayer:status": "npx ts-node scripts/session-relayer.ts status",
    "session:relayer:open": "npx ts-node scripts/session-relayer.ts open",
    "session:relayer:close": "npx ts-node scripts/session-relayer.ts close",
    "session:relayer:revoke": "npx ts-node scripts/session-relayer.ts revoke",
    "session:relayer:smoke": "npx ts-node scripts/session-relayer.ts smoke",
    "hosting:start": "npx ts-node scripts/hosting-stack.ts start",
    "hosting:stop": "npx ts-node scripts/hosting-stack.ts stop",
    "hosting:status": "npx ts-node scripts/hosting-stack.ts status",
    "hosting:restart": "npx ts-node scripts/hosting-stack.ts restart",
    "canary:devnet": "npx ts-node scripts/devnet-canary.ts --max-oracle-age-seconds 300",
    "oracle:alert:test": "npx ts-node scripts/test-alert-webhook.ts",
    "relay:watchdog": "npx ts-node scripts/relay-watchdog.ts",
    "circuit:force-upload": "npx ts-node scripts/force-upload-circuit.ts",
    "check:oracle": "npx ts-node scripts/oracle-health.ts --max-age-seconds 300",
    "check:preflight": "npx ts-node scripts/stable-preflight.ts --max-oracle-age-seconds 300",
    "check:stable": "npm run check:preflight && npm run check:oracle",
    "check:release-hygiene": "npx ts-node scripts/release-hygiene.ts --strict",
    "report:release-hygiene": "npx ts-node scripts/release-hygiene.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\""
  },
  "dependencies": {
    "@arcium-hq/client": "^0.8.5",
    "@coral-xyz/anchor": "0.32.1",
    "@noble/curves": "^1.3.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.91.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "chai": "^4.4.1",
    "mocha": "^10.2.0",
    "prettier": "^3.2.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
