<file path="app/src/styles/globals.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --foreground-rgb: 255, 255, 255;
  --background-rgb: 10, 10, 15;
  --range-track-empty: #35354a;
  --app-scrollbar-track: #12121a;
  --app-scrollbar-thumb: #2a2a3a;
  --app-scrollbar-thumb-hover: #5b4c9c;
}

html.light {
  --range-track-empty: #d1d5e8;
  --app-scrollbar-track: #eef1f7;
  --app-scrollbar-thumb: #cfd6e3;
  --app-scrollbar-thumb-hover: #aeb8cc;
}

body {
  color: rgb(var(--foreground-rgb));
  background: rgb(var(--background-rgb));
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* Custom scrollbar — near-invisible, hover to reveal */
* {
  scrollbar-color: transparent transparent;
  scrollbar-width: none;
}

*:hover {
  scrollbar-color: var(--app-scrollbar-thumb) transparent;
}

::-webkit-scrollbar {
  width: 1px;
  height: 1px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: transparent;
  border-radius: 999px;
}

*:hover::-webkit-scrollbar-thumb {
  background: var(--app-scrollbar-thumb);
}

*:hover::-webkit-scrollbar-thumb:hover {
  background: var(--app-scrollbar-thumb-hover);
}

/* Wallet adapter styles override */
.wallet-adapter-button {
  background: rgba(139, 92, 246, 0.12) !important;
  border: 1px solid rgba(139, 92, 246, 0.35) !important;
  border-radius: 10px !important;
  color: #c4b5fd !important;
  font-size: 12px !important;
  font-weight: 500 !important;
  height: 32px !important;
  padding: 0 12px !important;
  transition: background 0.2s, border-color 0.2s !important;
}

.wallet-adapter-button:not([disabled]):hover {
  background: rgba(139, 92, 246, 0.22) !important;
  border-color: rgba(139, 92, 246, 0.55) !important;
}

.wallet-adapter-button-trigger {
  background: rgba(139, 92, 246, 0.12) !important;
}

.wallet-adapter-dropdown {
  z-index: 1000 !important;
}

.wallet-adapter-dropdown-list {
  z-index: 1000 !important;
}

/* Glowing effect for privacy badge */
.privacy-glow {
  box-shadow: 0 0 20px rgba(139, 92, 246, 0.3);
}

/* Animated gradient background */
.gradient-bg {
  background: linear-gradient(-45deg, #0a0a0f, #1a1a25, #12121a, #0a0a0f);
  background-size: 400% 400%;
  animation: gradient 15s ease infinite;
}

@keyframes gradient {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.shadow-movers-strip {
  animation: shadow-movers-marquee 28s linear infinite;
}

.shadow-movers-strip:hover {
  animation-play-state: paused;
}

@keyframes shadow-movers-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Encrypted data visualization */
.encrypted-blur {
  filter: blur(4px);
  transition: filter 0.3s ease;
}

.encrypted-blur:hover {
  filter: blur(8px);
}

/* Position card */
.position-card {
  background: linear-gradient(135deg, rgba(26, 26, 37, 0.8) 0%, rgba(18, 18, 26, 0.9) 100%);
  border: 1px solid rgba(139, 92, 246, 0.2);
  backdrop-filter: blur(10px);
}

.position-card:hover {
  border-color: rgba(139, 92, 246, 0.5);
}

/* Position table rows */
.position-row td {
  background: linear-gradient(135deg, rgba(26, 26, 37, 0.6) 0%, rgba(18, 18, 26, 0.7) 100%);
  border-top: 1px solid rgba(139, 92, 246, 0.1);
  border-bottom: 1px solid rgba(139, 92, 246, 0.1);
  transition: background 0.15s, border-color 0.15s;
}
.position-row td:first-child {
  border-left: 1px solid rgba(139, 92, 246, 0.1);
  border-radius: 8px 0 0 8px;
}
.position-row td:last-child {
  border-right: 1px solid rgba(139, 92, 246, 0.1);
  border-radius: 0 8px 8px 0;
}
.position-row:hover td {
  background: rgba(139, 92, 246, 0.06);
  border-color: rgba(139, 92, 246, 0.25);
}

html.light .position-row td {
  background: rgba(248, 250, 252, 0.7);
  border-color: rgba(139, 92, 246, 0.12);
}
html.light .position-row:hover td {
  background: rgba(139, 92, 246, 0.05);
  border-color: rgba(139, 92, 246, 0.2);
}

/* Skeleton loading pulse */
.skeleton-pulse {
  background: linear-gradient(90deg, #1a1a25 25%, #252530 50%, #1a1a25 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Animate-in for component mount */
.animate-in {
  animation: animate-in 0.3s ease-out;
}

@keyframes animate-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Gradient border card */
.gradient-border-card {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.4) 0%, rgba(59, 130, 246, 0.4) 50%, rgba(16, 185, 129, 0.2) 100%);
}

/* Micro-interactions: button press */
.btn-press {
  transition: transform 0.1s ease, box-shadow 0.15s ease;
}

.btn-press:active {
  transform: scale(0.97);
}

/* Direction toggle glow */
.toggle-long.active {
  box-shadow: 0 0 20px rgba(16, 185, 129, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.toggle-short.active {
  box-shadow: 0 0 20px rgba(239, 68, 68, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

/* Custom range slider thumb */
input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #8b5cf6;
  cursor: pointer;
  border: 2px solid #1a1a25;
