            >
              Market
            </button>
            <button
              onClick={() => setOrderType("limit")}
              className={`pb-1 text-[11px] font-semibold transition-colors border-b-2 -mb-px ${
                orderType === "limit"
                  ? "text-white border-accent-purple"
                  : "text-gray-500 border-transparent hover:text-gray-300"
