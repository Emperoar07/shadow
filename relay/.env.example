# ── RPC ───────────────────────────────────────────────────────────────────────
# Primary RPC endpoint (comma-separated for failover)
SOLANA_RPC_URL=https://your-quicknode-endpoint.solana-devnet.quiknode.pro/YOUR_KEY/
# Optional additional RPC endpoints for failover
# SOLANA_RPC_URLS=https://rpc2.example.com,https://rpc3.example.com
# Optional WebSocket endpoints (derived from RPC URLs if omitted)
# SOLANA_WSS_URL=wss://your-quicknode-endpoint.solana-devnet.quiknode.pro/YOUR_KEY/

# ── Relayer keypair (one of the following) ────────────────────────────────────
# JSON array of secret key bytes (preferred for Railway env var)
SHADOWPERP_RELAYER_KEYPAIR_JSON=[1,2,3,...,64]
# OR path to keypair file (useful for local dev if ~/.config/solana/id.json exists)
# SHADOWPERP_RELAYER_KEYPAIR_PATH=/home/user/.config/solana/id.json

# ── Program / on-chain config ─────────────────────────────────────────────────
# Program ID — auto-read from IDL if omitted
# SHADOWPERP_PROGRAM_ID=

# Collateral mint (defaults to devnet USDC)
# SHADOWPERP_COLLATERAL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Arcium cluster offset (default: 456)
# ARCIUM_CLUSTER_OFFSET=456

# Arcium program IDs (defaults built-in)
# ARCIUM_PROGRAM_ID=
# ARCIUM_MXE_PROGRAM_ID=
# ARCIUM_CLUSTER_ACCOUNT=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
