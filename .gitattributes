# Normalise all text files to LF in the repository.
* text=auto eol=lf

# Explicitly LF for source and config files.
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.sh text eol=lf

# Binary files — no line ending conversion.
*.arcis binary
*.so binary
*.png binary
*.jpg binary
*.ico binary
