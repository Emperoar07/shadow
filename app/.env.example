NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional failover list (comma-separated). The app uses index 0 by default and lets you switch in UI.
# Example:
# NEXT_PUBLIC_SOLANA_RPC_URLS=https://devnet.helius-rpc.com/?api-key=...,https://rpc.ankr.com/solana_devnet/...,https://solana-devnet.g.alchemy.com/v2/...
NEXT_PUBLIC_SOLANA_RPC_URLS=
# Optional explorer cluster selector (used for tx links)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_ARCIUM_RPC_URL=https://devnet.helius-rpc.com

# ShadowPerp program ID - must match Anchor.toml [programs.devnet] after deployment.
# If omitted, runtime falls back to the program address embedded in app/src/idl/shadowperp.json.
NEXT_PUBLIC_SHADOWPERP_PROGRAM_ID=

# Arcium runtime program on devnet (fixed address, not your program)
NEXT_PUBLIC_ARCIUM_PROGRAM_ID=Arcj82pX7HxYKLR92qvgZUAd7vGS1k4hQvAFcPATFdEQ

# Arcium MXE PDA namespace.
# For this codebase, set this to your ShadowPerp program ID (or leave blank and it auto-falls back).
NEXT_PUBLIC_ARCIUM_MXE_PROGRAM_ID=

# Arcium cluster offset (default 456 for devnet)
NEXT_PUBLIC_ARCIUM_CLUSTER_OFFSET=456

# Arcium cluster account (leave blank to auto-derive from cluster offset)
NEXT_PUBLIC_ARCIUM_CLUSTER_ACCOUNT=

# Delegated session relay (server-side only; do NOT prefix with NEXT_PUBLIC_)
# Provide one of:
# 1) SHADOWPERP_RELAYER_KEYPAIR_JSON='[12,34,...]'
# 2) SHADOWPERP_RELAYER_KEYPAIR_PATH=/abs/path/to/relayer-id.json
# Fallback: ~/.config/solana/id.json
SHADOWPERP_RELAYER_KEYPAIR_JSON=
SHADOWPERP_RELAYER_KEYPAIR_PATH=
# Relay watchdog base URL (for scripts/relay-watchdog.ts health checks)
RELAY_WATCHDOG_BASE_URL=http://localhost:3000
# Optional relay-specific alert webhook. Falls back to ORACLE_ALERT_WEBHOOK_URL if unset.
RELAY_ALERT_WEBHOOK_URL=

# Deployed market PDA (output of the initialize instruction)
# Optional: if omitted, runtime derives market PDA from
#   seeds ["market", NEXT_PUBLIC_SHADOWPERP_COLLATERAL_MINT]
# using your ShadowPerp program ID.
NEXT_PUBLIC_SHADOWPERP_MARKET_ACCOUNT=
# Collateral mint for market derivation fallback (defaults to canonical devnet USDC)
NEXT_PUBLIC_SHADOWPERP_COLLATERAL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional UI-v2 presentation wrapper layer (1 = enabled, 0/empty = default layout)
NEXT_PUBLIC_UI_V2=0
# Backward-compatible alias (deprecated; use NEXT_PUBLIC_UI_V2)
NEXT_PUBLIC_SAFE_UI_ADAPT=0

# Optional backend price provider key (server-side only; do NOT prefix with NEXT_PUBLIC_).
# If set, /api/prices can fail over to CoinMarketCap when CoinGecko is degraded.
COINMARKETCAP_API_KEY=

# Oracle feeder hardening controls (used by scripts/price-oracle.ts)
# Force refresh heartbeat in seconds (must stay below on-chain freshness gate)
ORACLE_HEARTBEAT_SECONDS=120
# Publish only when median price moved by at least this many bps (1 bps = 0.01%)
ORACLE_MIN_MOVE_BPS=10
# Circuit-breaker maximum deviation vs last accepted on-chain price
ORACLE_MAX_DEVIATION_BPS=500
# Require at least this many healthy upstream price sources before publish
ORACLE_MIN_SOURCES_REQUIRED=2
# Optional guarded fallback if source count drops below minimum and freshness is at risk
ORACLE_FAILSAFE_ALLOW_SINGLE_SOURCE=1
# Max allowed move vs last accepted price when guarded single-source fallback is used
ORACLE_FAILSAFE_MAX_MOVE_BPS=150
# Enable freeze mode when sources disagree beyond threshold
ORACLE_SAFETY_MODE=1
# Freeze updates if source disagreement exceeds this (bps)
ORACLE_SOURCE_DISAGREE_BPS=120
# Alert when oracle age approaches staleness
ORACLE_STALE_ALERT_SECONDS=240
# Alert dedupe window
ORACLE_ALERT_COOLDOWN_SECONDS=300
# Optional alert webhook endpoint (POST JSON)
ORACLE_ALERT_WEBHOOK_URL=
# Polling jitter in ms for daemon loop
ORACLE_JITTER_MS=3000
