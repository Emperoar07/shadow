NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Server-only RPC for scripts/relay/oracle (keep private; do NOT commit real keys)
SOLANA_RPC_URL=
# Optional server-only failover list (comma/newline separated)
# Recommended order: primary paid RPC first, then secondary paid RPCs, then public devnet last.
SOLANA_RPC_URLS=
# Optional server-only websocket failover list aligned by index with SOLANA_RPC_URLS
SOLANA_WSS_URL=
SOLANA_WSS_URLS=
# Optional public failover list (comma-separated). The app uses index 0 by default and lets you switch in UI.
# Example:
# NEXT_PUBLIC_SOLANA_RPC_URLS=https://<quicknode>,https://<zan>,https://devnet.helius-rpc.com/?api-key=...,https://solana-devnet.g.alchemy.com/v2/...,https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URLS=
# Optional public websocket failover list aligned by index with NEXT_PUBLIC_SOLANA_RPC_URLS
# Example:
# NEXT_PUBLIC_SOLANA_WSS_URLS=wss://<quicknode>,wss://<zan>,wss://devnet.helius-rpc.com/?api-key=...,wss://solana-devnet.g.alchemy.com/v2/...,wss://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WSS_URL=
NEXT_PUBLIC_SOLANA_WSS_URLS=
# Optional explorer cluster selector (used for tx links)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_ARCIUM_RPC_URL=https://devnet.helius-rpc.com

# Server-only oracle refresher used by /api/oracle-refresh before opening positions.
# Must be the market's authorized price_feeder. Use one JSON array secret key value.
ORACLE_FEEDER_SECRET_KEY=
# Optional: require more/less external sources before publishing a pre-trade refresh.
ORACLE_REFRESH_MIN_SOURCES=2

# Optional Solana gas sponsorship (server fee payer path).
# Supported clusters are restricted to devnet and mainnet-beta.
# When enabled, the browser signs first and the app server adds the fee-payer signature.
NEXT_PUBLIC_SOLANA_GAS_SPONSOR_ENABLED=0
NEXT_PUBLIC_SOLANA_GAS_SPONSOR_PUBKEY=
SOLANA_GAS_SPONSOR_ENABLED=0
SOLANA_GAS_SPONSOR_SECRET_KEY=

# Optional durable rate limiting and faucet cooldown/drip records.
# Configure one pair in hosted production; mutation/signer endpoints fail closed in production without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV compatible aliases are also supported:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set to false only for temporary devnet hosted testing without durable limits.
REQUIRE_DURABLE_RATE_LIMITS=true

# ShadowPerp program ID - must match Anchor.toml [programs.devnet] after deployment.
# If omitted, runtime falls back to the program address embedded in app/src/idl/shadowperp.json.
NEXT_PUBLIC_SHADOWPERP_PROGRAM_ID=

# Arcium runtime program on devnet (fixed address, not your program)
NEXT_PUBLIC_ARCIUM_PROGRAM_ID=Arcj82pX7HxYKLR92qvgZUAd7vGS1k4hQvAFcPATFdEQ

# Arcium MXE PDA namespace.
# For this codebase, set this to your ShadowPerp program ID (or leave blank and it auto-falls back).
NEXT_PUBLIC_ARCIUM_MXE_PROGRAM_ID=

# Arcium cluster offset (default 456 for devnet)
NEXT_PUBLIC_ARCIUM_CLUSTER_OFFSET=456

# Arcium cluster account (leave blank to auto-derive from cluster offset)
NEXT_PUBLIC_ARCIUM_CLUSTER_ACCOUNT=

# Delegated session relay (server-side only; do NOT prefix with NEXT_PUBLIC_)
# Provide one of:
# 1) SHADOWPERP_RELAYER_KEYPAIR_JSON='[12,34,...]'
# 2) SHADOWPERP_RELAYER_KEYPAIR_PATH=/abs/path/to/relayer-id.json
# Local/dev fallback: ~/.config/solana/id.json is only used when NODE_ENV != production
SHADOWPERP_RELAYER_KEYPAIR_JSON=
SHADOWPERP_RELAYER_KEYPAIR_PATH=

# Privy app ID (from dashboard.privy.io → Settings → Basics)
# Required for hosted deployments. Shadow now uses Privy for email and Solana wallet sign-in
# and intentionally does not fall back to an old tenant ID.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional custom Privy auth/API domain when HttpOnly cookies are enabled.
# Example: https://privy.www.shadowperpdex.xyz
# Set this in hosted production if the Privy dashboard is routing auth through your custom domain.
NEXT_PUBLIC_PRIVY_API_URL=
# Server-only Privy app credentials for protected backend routes (for example gas sponsorship auth verification)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional WalletConnect / Reown Cloud project ID for external-wallet QR flows on mobile.
# Create one at https://cloud.reown.com and set it for hosted deployments.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional canonical host redirect for hosted production. If set, Shadow redirects
# the apex or alternate host to this hostname so Privy always sees one approved origin.
NEXT_PUBLIC_CANONICAL_HOST=www.shadowperpdex.xyz

# Relay watchdog base URL (for scripts/relay-watchdog.ts health checks)
# In production, set this to the standalone relay URL (e.g. https://shadow-production-d2d8.up.railway.app)
RELAY_WATCHDOG_BASE_URL=http://localhost:3000
# Optional relay-specific alert webhook. Falls back to ORACLE_ALERT_WEBHOOK_URL if unset.
RELAY_ALERT_WEBHOOK_URL=

# Deployed market PDA (output of the initialize instruction)
# Optional: if omitted, runtime derives market PDA from
#   seeds ["market", NEXT_PUBLIC_SHADOWPERP_COLLATERAL_MINT]
# using your ShadowPerp program ID.
NEXT_PUBLIC_SHADOWPERP_MARKET_ACCOUNT=
# Collateral mint for market derivation fallback (defaults to canonical devnet USDC)
NEXT_PUBLIC_SHADOWPERP_COLLATERAL_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional UI-v2 presentation wrapper layer (1 = enabled, 0/empty = default layout)
NEXT_PUBLIC_UI_V2=0
# Backward-compatible alias (deprecated; use NEXT_PUBLIC_UI_V2)
NEXT_PUBLIC_SAFE_UI_ADAPT=0
# Partial live mode: disable trading actions in UI (1 = disabled)
NEXT_PUBLIC_TRADING_DISABLED=0
# Enable delegated session-based collateral deposits (requires updated on-chain instruction + synced IDL)
NEXT_PUBLIC_SESSION_DEPOSIT_ENABLED=0

# Optional backend price provider key (server-side only; do NOT prefix with NEXT_PUBLIC_).
# If set, /api/prices can fail over to CoinMarketCap when CoinGecko is degraded.
COINMARKETCAP_API_KEY=

# Oracle feeder hardening controls (used by scripts/price-oracle.ts)
# Force refresh heartbeat in seconds (must stay below on-chain freshness gate)
ORACLE_HEARTBEAT_SECONDS=120
# Publish only when median price moved by at least this many bps (1 bps = 0.01%)
ORACLE_MIN_MOVE_BPS=10
# Circuit-breaker maximum deviation vs last accepted on-chain price
ORACLE_MAX_DEVIATION_BPS=500
# Require at least this many healthy upstream price sources before publish
ORACLE_MIN_SOURCES_REQUIRED=2
# Optional guarded fallback if source count drops below minimum and freshness is at risk
ORACLE_FAILSAFE_ALLOW_SINGLE_SOURCE=1
# Max allowed move vs last accepted price when guarded single-source fallback is used
ORACLE_FAILSAFE_MAX_MOVE_BPS=150
# Enable freeze mode when sources disagree beyond threshold
ORACLE_SAFETY_MODE=1
# Freeze updates if source disagreement exceeds this (bps)
ORACLE_SOURCE_DISAGREE_BPS=120
# Alert when oracle age approaches staleness
ORACLE_STALE_ALERT_SECONDS=240
# Alert dedupe window
ORACLE_ALERT_COOLDOWN_SECONDS=300
# Optional alert webhook endpoint (POST JSON)
ORACLE_ALERT_WEBHOOK_URL=
# Polling jitter in ms for daemon loop
ORACLE_JITTER_MS=3000
